[Unit]
Description=Trailscope Cloud waitlist endpoint (website)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/trailscope-waitlist/waitlist.py serve --db /var/lib/trailscope-waitlist/waitlist.db --host 127.0.0.1 --port 8790
DynamicUser=yes
StateDirectory=trailscope-waitlist
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
MemoryMax=128M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
