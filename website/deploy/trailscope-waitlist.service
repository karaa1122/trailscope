[Unit]
Description=Trailscope Cloud waitlist endpoint (website)
After=network.target

[Service]
# Optional: RESEND_API_KEY=re_… (root-only file) turns on an email to hello@ for each new signup.
EnvironmentFile=-/etc/trailscope-waitlist.env
ExecStart=/usr/bin/python3 /opt/trailscope-waitlist/waitlist.py serve --db /var/lib/trailscope-waitlist/waitlist.db --host 127.0.0.1 --port 8790 --notify-to hello@__DOMAIN__ --notify-from "Trailscope waitlist <waitlist@__DOMAIN__>"
DynamicUser=yes
StateDirectory=trailscope-waitlist
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
MemoryMax=128M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
