---
import '../styles/fonts.css';
import '../styles/site.css';
import logo from '../assets/logo.svg';
import Icon from '../components/Icon.astro';
import { CONTACT, NAV, REPO } from '../site';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (thank-you and error pages). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0c0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trailscope" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Trailscope home">
          <img src={logo.src} width="26" height="26" alt="" />
          trailscope
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <a class="gh-link" href={REPO}><Icon name="github" /> GitHub</a>
          <a class="btn small" href="/docs/self-hosting/">Get started</a>
          <details class="menu">
            <summary aria-label="Menu"><Icon name="menu" /></summary>
            <div class="menu-panel">
              {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
              <a href={REPO}>GitHub</a>
              <a href="/docs/self-hosting/">Get started</a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/">
              <img src={logo.src} width="26" height="26" alt="" />
              trailscope
            </a>
            <p>Open-source, self-hosted API request logging. Your requests stay on your server.</p>
          </div>
          <div>
            <h2>Product</h2>
            <ul>
              <li><a href="/#features">Features</a></li>
              <li><a href="/pricing/">Pricing</a></li>
              <li><a href="/pricing/#waitlist">Cloud waitlist</a></li>
              <li><a href="/docs/benchmarks/">Benchmarks</a></li>
            </ul>
          </div>
          <div>
            <h2>Docs</h2>
            <ul>
              <li><a href="/docs/self-hosting/">Self-hosting</a></li>
              <li><a href="/docs/query-language/">Query language</a></li>
              <li><a href="/docs/sdk-spec/">SDKs</a></li>
              <li><a href="/docs/api/">HTTP API</a></li>
            </ul>
          </div>
          <div>
            <h2>Project</h2>
            <ul>
              <li><a href={REPO}>GitHub</a></li>
              <li><a href={`${REPO}/issues`}>Issues</a></li>
              <li><a href={`${REPO}/blob/main/SECURITY.md`}>Security</a></li>
              <li><a href={`mailto:${CONTACT}`}>Contact</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Trailscope contributors · Apache-2.0</span>
          <a href="/privacy/">Privacy</a>
        </div>
      </div>
    </footer>
  </body>
</html>
