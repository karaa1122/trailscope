---
import { Code } from 'astro:components';
import { codeTheme } from '../code-theme';

type Lang = 'ts' | 'python' | 'php' | 'xml' | 'properties' | 'bash' | 'dotenv';

interface Block {
  file: string;
  lang: Lang;
  code: string;
}

interface Tab {
  id: string;
  label: string;
  blocks: Block[];
}

const tabs: Tab[] = [
  {
    id: 'express',
    label: 'Express',
    blocks: [
      { file: 'terminal', lang: 'bash', code: 'npm install @trailscope/express' },
      {
        file: 'app.ts',
        lang: 'ts',
        code: `import express from 'express';
import { init, trailscope, trailscopeErrorHandler } from '@trailscope/express';

init({ service: 'orders-api' }); // endpoint and ingest key from the environment
const app = express();
app.use(trailscope());
// ... your routes
app.use(trailscopeErrorHandler());`,
      },
    ],
  },
  {
    id: 'nestjs',
    label: 'NestJS',
    blocks: [
      { file: 'terminal', lang: 'bash', code: 'npm install @trailscope/nestjs' },
      {
        file: 'app.module.ts',
        lang: 'ts',
        code: `import { Module } from '@nestjs/common';
import { TrailscopeModule } from '@trailscope/nestjs';

@Module({ imports: [TrailscopeModule.forRoot({ service: 'orders-api' })] })
export class AppModule {}`,
      },
    ],
  },
  {
    id: 'fastapi',
    label: 'FastAPI',
    blocks: [
      { file: 'terminal', lang: 'bash', code: 'pip install trailscope' },
      {
        file: 'main.py',
        lang: 'python',
        code: `import trailscope
from fastapi import FastAPI
from trailscope.asgi import TrailscopeMiddleware

trailscope.init(service="orders-api")
app = FastAPI()
app.add_middleware(TrailscopeMiddleware)`,
      },
    ],
  },
  {
    id: 'django',
    label: 'Django',
    blocks: [
      { file: 'terminal', lang: 'bash', code: 'pip install trailscope' },
      {
        file: 'settings.py',
        lang: 'python',
        code: `MIDDLEWARE = ["trailscope.django.TrailscopeMiddleware", ...]
TRAILSCOPE = {"service": "orders-api"}`,
      },
    ],
  },
  {
    id: 'laravel',
    label: 'Laravel',
    blocks: [
      { file: 'terminal', lang: 'bash', code: 'composer require trailscope/trailscope' },
      {
        file: '.env',
        lang: 'dotenv',
        code: `TRAILSCOPE_ENDPOINT=https://trailscope.example.com
TRAILSCOPE_INGEST_KEY=trs_ingest_…
TRAILSCOPE_SERVICE=orders-api`,
      },
    ],
  },
  {
    id: 'spring',
    label: 'Spring Boot',
    blocks: [
      {
        file: 'pom.xml',
        lang: 'xml',
        code: `<dependency>
  <groupId>dev.trailscope</groupId>
  <artifactId>trailscope-spring-boot-starter</artifactId>
  <version>0.1.0</version>
</dependency>`,
      },
      {
        file: 'application.properties',
        lang: 'properties',
        code: 'trailscope.service=orders-api',
      },
    ],
  },
  {
    id: 'otel',
    label: 'OpenTelemetry',
    blocks: [
      {
        file: 'environment',
        lang: 'bash',
        code: `OTEL_EXPORTER_OTLP_ENDPOINT=https://trailscope.example.com/v1/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20trs_ingest_…`,
      },
    ],
  },
];
---

<div class="code-tabs" data-tabs>
  <div class="tablist" role="tablist" aria-label="Framework" hidden>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, i) => (
      <div
        class="tabpanel"
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={i !== 0}
      >
        {tab.blocks.map((block) => (
          <>
            <span class="file">{block.file}</span>
            <Code code={block.code} lang={block.lang} theme={codeTheme} />
          </>
        ))}
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    if (!list) continue;
    list.hidden = false;

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === 'ArrowRight'
            ? (i + 1) % tabs.length
            : event.key === 'ArrowLeft'
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : null;
        if (next !== null) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  }
</script>
