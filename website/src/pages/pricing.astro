---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import { CONTACT } from '../site';

// Planned Trailscope Cloud plans (docs/DECISIONS.md, decision 065).
// Nothing here is billed yet; the page says so.
const plans = [
  {
    kind: 'Self-hosted',
    name: 'Open source',
    price: '$0',
    per: 'forever',
    blurb: 'Everything, on your own server, with no limits.',
    cta: { label: 'Self-hosting guide', href: '/docs/self-hosting/' },
    features: [
      'Unlimited requests and projects',
      'Retention you choose',
      'Every feature, no license key',
      'Your data never leaves your servers',
      'Community support on GitHub',
    ],
  },
  {
    kind: 'Cloud',
    name: 'Free',
    price: '$0',
    per: 'per month',
    blurb: 'For side projects and trying Trailscope out.',
    cta: { label: 'Join the waitlist', href: '/pricing/?plan=free#waitlist' },
    features: [
      '1 million events a month',
      '7 days of history',
      '2 projects, 3 members',
      'Email alerts and Email on 5xx',
    ],
  },
  {
    kind: 'Cloud',
    name: 'Team',
    price: '$19',
    per: 'per month',
    blurb: 'For production APIs and the team that runs them.',
    featured: true,
    cta: { label: 'Join the waitlist', href: '/pricing/?plan=team#waitlist' },
    features: [
      '10 million events a month',
      '30 days of history, 7 days of bodies',
      'Unlimited projects and members',
      'Slack, Telegram and webhook alerts',
      'Replay to your staging servers',
      '$1.50 per extra million events',
    ],
  },
  {
    kind: 'Cloud',
    name: 'Business',
    price: '$99',
    per: 'per month',
    blurb: 'For larger traffic, longer history and SSO.',
    cta: { label: 'Join the waitlist', href: '/pricing/?plan=business#waitlist' },
    features: [
      '50 million events a month',
      '90 days of history, 14 days of bodies',
      'Single sign-on (OpenID Connect)',
      'Priority email support',
      '$1.20 per extra million events',
    ],
  },
] as const;

type Cell = string | boolean;
const rows: { group: string; items: [string, Cell, Cell, Cell, Cell][] }[] = [
  {
    group: 'Usage',
    items: [
      ['Events per month', 'Unlimited', '1M', '10M', '50M'],
      ['Extra events', '—', 'Paused until next month', '$1.50 per million', '$1.20 per million'],
      ['History', 'You choose', '7 days', '30 days', '90 days'],
      ['Request and response bodies', 'You choose', '3 days', '7 days', '14 days'],
      ['Projects', 'Unlimited', '2', 'Unlimited', 'Unlimited'],
      ['Members', 'Unlimited', '3', 'Unlimited', 'Unlimited'],
    ],
  },
  {
    group: 'Features',
    items: [
      ['Live tail, Explore, Journeys, Errors, Routes', true, true, true, true],
      ['SQL filters, saved views, shareable links', true, true, true, true],
      ['Email alerts and Email on 5xx', true, true, true, true],
      ['Slack, Telegram and signed webhooks', true, false, true, true],
      ['Copy as cURL', true, true, true, true],
      ['Replay to allowed targets', true, false, true, true],
      ['HTTP API and API tokens', true, true, true, true],
      ['OpenTelemetry (OTLP/HTTP) ingest', true, true, true, true],
      ['Single sign-on (OIDC)', true, false, false, true],
    ],
  },
  {
    group: 'Running it',
    items: [
      ['Hosting', 'Your servers', 'EU', 'EU', 'EU'],
      ['Upgrades and backups', 'You', 'Us', 'Us', 'Us'],
      ['Support', 'GitHub issues', 'GitHub issues', 'Email', 'Priority email'],
    ],
  },
];

const faq = [
  {
    q: 'Is Trailscope Cloud available yet?',
    a: "Not yet. We're building it now. Join the waitlist and we'll email you once when it opens. Self-hosted Trailscope is available today.",
  },
  {
    q: 'Is the self-hosted version limited?',
    a: 'No. Self-hosted Trailscope has every feature, with no event limits and no license key. The Cloud runs the same open-source software; you pay for us running it.',
  },
  {
    q: 'What counts as an event?',
    a: 'Each request, background job run or log line you send is one event. The spans and the error inside a request come with it at no extra cost.',
  },
  {
    q: 'What happens if I send more than my plan includes?',
    a: "On Team and Business, extra events are billed per million at the end of the month. On Free, Trailscope stops accepting new events until the next month starts; the SDKs drop them quietly and your app isn't slowed down.",
  },
  {
    q: 'Where will my data be stored?',
    a: 'In the EU (Frankfurt) at launch. Bodies and headers are redacted in your app before they are sent, and again on our side.',
  },
  {
    q: 'Can these prices change?',
    a: 'Yes. These are the planned prices and may change before launch. Anyone who joins the waitlist hears about the final prices before being asked to pay anything.',
  },
] as const;
---

<Base
  title="Pricing · Trailscope"
  description="Self-host Trailscope free forever, or join the waitlist for Trailscope Cloud: a free plan, Team at $19 a month and Business at $99 a month."
>
  <div class="page-head wrap">
    <span class="eyebrow">Pricing</span>
    <h1>Free to self-host. Cloud when you'd rather not.</h1>
    <p>
      Trailscope is open source and free to run on your own servers. Trailscope Cloud will run it for
      you, with the same features.
    </p>
    <p class="notice">
      Trailscope Cloud isn't live yet. These are the planned prices; nothing is charged today.
    </p>
  </div>

  <section style="padding-top: 0">
    <div class="wrap">
      <div class="plans">
        {
          plans.map((plan) => (
            <div class={`plan${'featured' in plan ? ' featured' : ''}`}>
              {'featured' in plan && <span class="badge">Most teams</span>}
              <span class="kind">{plan.kind}</span>
              <h2>{plan.name}</h2>
              <div class="price">
                <strong>{plan.price}</strong>
                <span>{plan.per}</span>
              </div>
              <p class="blurb">{plan.blurb}</p>
              <a class={`btn${'featured' in plan ? ' primary' : ''}`} href={plan.cta.href}>
                {plan.cta.label}
              </a>
              <ul class="checks">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="enterprise">
        <span>
          <strong>More than 500 million events a month, a dedicated server or a DPA?</strong> We'll
          work out a plan with you.
        </span>
        <a class="btn small" href={`mailto:${CONTACT}?subject=Trailscope%20Cloud`}>Contact us</a>
      </div>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <div class="section-head">
        <h2>Compare plans</h2>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col">Self-hosted</th>
              <th scope="col">Free</th>
              <th scope="col">Team</th>
              <th scope="col">Business</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((section) => (
                <>
                  <tr class="group">
                    <th scope="colgroup" colspan="5">
                      {section.group}
                    </th>
                  </tr>
                  {section.items.map(([label, ...cells]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      {cells.map((cell) =>
                        cell === true ? (
                          <td class="yes">
                            ✓<span class="sr-only">Included</span>
                          </td>
                        ) : cell === false ? (
                          <td class="no">
                            —<span class="sr-only">Not included</span>
                          </td>
                        ) : (
                          <td>{cell}</td>
                        ),
                      )}
                    </tr>
                  ))}
                </>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <div class="section-head center">
        <h2>Questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <Waitlist />
    </div>
  </section>
</Base>
