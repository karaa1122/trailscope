---
import Base from '../layouts/Base.astro';
---

<Base
  noindex
  title="That didn't work · Trailscope"
  description="Joining the Trailscope Cloud waitlist failed."
>
  <article class="prose">
    <span class="eyebrow">Trailscope Cloud</span>
    <h1>That didn't work.</h1>
    <p>
      We couldn't add you to the waitlist. Please check the email address and try again in a few
      minutes.
    </p>
    <div class="actions">
      <a class="btn primary" href="/pricing/#waitlist">Try again</a>
      <a class="btn" href="/">Back to the home page</a>
    </div>
  </article>
</Base>
