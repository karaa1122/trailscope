---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import Icon from '../components/Icon.astro';
import Waitlist from '../components/Waitlist.astro';
import { REPO } from '../site';

import liveTail from '../../../docs/images/live-tail.png';
import inspector from '../../../docs/images/inspector.png';
import journey from '../../../docs/images/journey.png';
import explore from '../../../docs/images/explore.png';
import routes from '../../../docs/images/routes.png';

const quickstart = `git clone ${REPO}
cd trailscope/deploy
docker compose up -d`;

const more = [
  {
    icon: 'activity',
    title: 'Live tail',
    text: 'Requests on screen within a second, with live tiles, a route heatmap and new errors as they appear.',
  },
  {
    icon: 'bell',
    title: 'Alert rules',
    text: 'On 5xx rate, p95 latency, counts or new and spiking errors, to email, Slack, Telegram or signed webhooks.',
  },
  {
    icon: 'mail',
    title: 'Email on 5xx',
    text: 'Hear about server errors in real time, with throttling, digests, regression notices and one-click mute links.',
  },
  {
    icon: 'replay',
    title: 'Copy as cURL, replay',
    text: 'Reproduce any request from your terminal, or replay it against a staging server you allowed.',
  },
  {
    icon: 'eyeOff',
    title: 'Redaction, twice',
    text: 'Passwords, tokens and card fields are masked in your app before sending, and again on the server.',
  },
  {
    icon: 'shield',
    title: 'Roles and body access',
    text: 'Owners, admins, members and viewers, plus a separate permission to see request and response bodies.',
  },
  {
    icon: 'login',
    title: 'Single sign-on',
    text: 'Sign in with any OpenID Connect provider (Google, Microsoft Entra, Okta, Keycloak and others).',
  },
  {
    icon: 'share',
    title: 'OpenTelemetry',
    text: 'No SDK for your stack? Point an OTLP/HTTP exporter at Trailscope and your spans become requests.',
  },
] as const;
---

<Base
  title="Trailscope: self-hosted API request logging"
  description="See every request your services handle, filter them with SQL and follow one customer across services and background jobs. Open source, on your own server."
>
  <section class="hero">
    <div class="wrap">
      <a class="pill" href={REPO}
        ><b>Open source</b> Apache-2.0<span class="more"> · runs on your server</span>
        <Icon name="arrowRight" /></a
      >
      <h1>See <em>every request</em> your API handles.</h1>
      <p class="lede">
        Trailscope logs each request your services handle (status, timing, headers, bodies and
        errors) on your own server. Filter them with SQL, open any one to see what went wrong, and
        follow a customer across services and background jobs.
      </p>
      <div class="cta">
        <a class="btn primary" href="#quickstart">Self-host in a minute</a>
        <a class="btn" href="/pricing/#waitlist">Join the Cloud waitlist</a>
      </div>
      <div class="term">
        <pre><span class="p">$ </span>git clone {REPO}
<span class="p">$ </span>cd trailscope/deploy
<span class="p">$ </span>docker compose up -d</pre>
        <button class="copy" type="button" data-copy={quickstart} aria-label="Copy the commands">
          <Icon name="copy" />
        </button>
      </div>
    </div>
    <div class="hero-shot">
      <div class="frame">
        <Image
          src={liveTail}
          alt="Trailscope live tail: request rate, error rate and p95 tiles, a route heatmap with a release marker, new errors and the request stream"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 1240px) 100vw, 1240px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <div class="works">
    <div class="wrap">
      <p>SDKs for the frameworks you already use</p>
      <ul>
        <li>Express</li>
        <li>Fastify</li>
        <li>NestJS</li>
        <li>Django</li>
        <li>FastAPI</li>
        <li>Celery</li>
        <li>Laravel</li>
        <li>Spring Boot</li>
        <li>OpenTelemetry</li>
      </ul>
    </div>
  </div>

  <section id="features">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Why Trailscope</span>
        <h2>Answers in the request itself, not in a pile of log lines.</h2>
        <p>
          Your API already knows what happened. Trailscope keeps every request with its context, so
          "what did this customer see at 14:02?" takes seconds, not an afternoon.
        </p>
      </div>

      <div class="feature">
        <div class="feature-text">
          <span class="eyebrow">Inspector</span>
          <h3>Debug the request, not a log line.</h3>
          <p>
            Open any request and see what was sent and answered, the error with its stack, and where
            the time went.
          </p>
          <ul class="checks">
            <li>Headers, bodies, user, release and journey keys</li>
            <li>A timing waterfall of the spans inside the request</li>
            <li>Copy as cURL or replay it against staging</li>
          </ul>
        </div>
        <div class="frame">
          <Image
            src={inspector}
            alt="Request inspector showing a failed request with its error, stack trace and timing waterfall"
            widths={[640, 960, 1440]}
            sizes="(max-width: 900px) 100vw, 680px"
          />
        </div>
      </div>

      <div class="feature flip">
        <div class="feature-text">
          <span class="eyebrow">Journeys</span>
          <h3>Follow one customer across everything.</h3>
          <p>
            Tag requests with a user, account, order or session, and Trailscope puts everything for it
            on one timeline, across services, background jobs and log lines.
          </p>
          <ul class="checks">
            <li>Jobs and log lines started from a request are linked automatically</li>
            <li>Answer support tickets with what actually happened</li>
          </ul>
        </div>
        <div class="frame">
          <Image
            src={journey}
            alt="Journey of one account: requests, background jobs and log events across services on one timeline"
            widths={[640, 960, 1440]}
            sizes="(max-width: 900px) 100vw, 680px"
          />
        </div>
      </div>

      <div class="feature">
        <div class="feature-text">
          <span class="eyebrow">Explore</span>
          <h3>Filter with the SQL you already know.</h3>
          <p>
            Write a <code>WHERE</code> clause, use quick search, or click filter chips. Group by any column
            with p50, p95 and p99, and share the view as a link.
          </p>
          <div class="queries">
            <code><span>status &gt;= 500</span> AND route LIKE '/checkout/%'</code>
            <code><span>status:5xx</span> user:u_42 duration:&gt;1s</code>
            <small>Well under half a second over 100 million requests.</small>
          </div>
        </div>
        <div class="frame">
          <Image
            src={explore}
            alt="Explore page with a status:5xx search, a chart of matching requests and the result list"
            widths={[640, 960, 1440]}
            sizes="(max-width: 900px) 100vw, 680px"
          />
        </div>
      </div>

      <div class="feature flip">
        <div class="feature-text">
          <span class="eyebrow">Errors and routes</span>
          <h3>Find the release that broke it.</h3>
          <p>
            Errors are grouped by fingerprint with first and last seen, users affected and the release
            that introduced them. The route heatmap shows latency and errors per minute, with every
            deploy marked.
          </p>
          <ul class="checks">
            <li>New and spiking errors on the live tail</li>
            <li>Release markers on every chart</li>
          </ul>
        </div>
        <div class="frame">
          <Image
            src={routes}
            alt="Route heatmap of p95 latency per route and minute, with a release marker"
            widths={[640, 960, 1440]}
            sizes="(max-width: 900px) 100vw, 680px"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">And everything around it</span>
        <h2>Built for the team that gets paged.</h2>
      </div>
      <div class="grid">
        {
          more.map((item) => (
            <div class="card">
              <span class="icon">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="divider" id="sdks">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Add it to your app</span>
        <h2>A few lines, and every request shows up.</h2>
        <p>
          The SDKs send in the background, add at most 0.05 ms per request, and mask passwords and
          tokens before anything leaves your process.
        </p>
      </div>
      <CodeTabs />
      <p class="code-note">
        Then call <code>setUser(id)</code> or <code>setCorrelation('order_id', id)</code> anywhere in a
        request to make it part of a journey. <a href="/docs/sdk-spec/">All SDKs</a>
      </p>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Fast and cheap to run</span>
        <h2>One Rust binary, ClickHouse and Postgres.</h2>
        <p>
          Everything runs on one small machine. ClickHouse stores a request in about 70 bytes, so
          100 million requests take under 7 GB of disk.
        </p>
      </div>
      <div class="stats">
        <div class="stat">
          <strong>50,000<small>/s</small></strong>
          <span>events ingested on 4 vCPU, at p99 17 ms</span>
        </div>
        <div class="stat">
          <strong>&lt;0.5<small>s</small></strong>
          <span>filtered queries over 102 million requests</span>
        </div>
        <div class="stat">
          <strong>0.05<small>ms</small></strong>
          <span>the most an SDK adds to a request</span>
        </div>
        <div class="stat">
          <strong>0.6<small>s</small></strong>
          <span>from your API to the live tail (p95)</span>
        </div>
      </div>
      <p class="stats-note">
        Measured and reproducible: <a href="/docs/benchmarks/">how we benchmarked</a>.
      </p>

      <div class="flow" style="margin-top: 56px">
        <div class="flow-col">
          <h3>Your services</h3>
          <ul>
            <li><b>Trailscope SDKs</b><small>Node, Python, PHP, Java</small></li>
            <li><b>OpenTelemetry</b><small>any OTLP/HTTP exporter</small></li>
            <li><b>Plain HTTP</b><small>gzipped JSON batches</small></li>
          </ul>
        </div>
        <div class="arrow"><Icon name="arrowRight" /></div>
        <div class="flow-col core">
          <h3>Trailscope, on your server</h3>
          <ul>
            <li><b>Ingest</b><small>validates, redacts and groups errors, then batches</small></li>
            <li><b>ClickHouse</b><small>requests, spans, events and rollups</small></li>
            <li><b>Postgres</b><small>users, projects, alerts and settings</small></li>
          </ul>
        </div>
        <div class="arrow"><Icon name="arrowRight" /></div>
        <div class="flow-col">
          <h3>Your team</h3>
          <ul>
            <li><b>Web UI</b><small>live tail, Explore, journeys, errors</small></li>
            <li><b>Alerts</b><small>email, Slack, Telegram, webhooks</small></li>
            <li><b>HTTP API</b><small>with tokens and OpenAPI</small></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="divider" id="quickstart">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Quickstart</span>
        <h2>Running in about a minute.</h2>
        <p>All you need is Docker. The setup wizard does the rest.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Start it</h3>
          <p>Trailscope, ClickHouse and Postgres in one Compose file.</p>
          <pre>git clone {REPO}
cd trailscope/deploy
docker compose up -d</pre>
        </li>
        <li>
          <h3>Create your project</h3>
          <p>
            Open <code>http://localhost:8080</code>. The wizard creates your account and first project and
            shows its ingest key.
          </p>
          <pre>docker compose exec trailscope \
  trailscope demo --url http://localhost:8080</pre>
          <p>Optional: demo traffic with a scripted incident.</p>
        </li>
        <li>
          <h3>Add the SDK</h3>
          <p>
            Install the package for your framework and set two environment variables. Production setup,
            TLS and backups: <a href="/docs/self-hosting/">self-hosting guide</a>.
          </p>
          <pre>TRAILSCOPE_ENDPOINT=http://localhost:8080
TRAILSCOPE_INGEST_KEY=trs_ingest_…</pre>
        </li>
      </ol>
    </div>
  </section>

  <section class="divider">
    <div class="wrap">
      <div class="teaser">
        <div class="option">
          <span class="tag">Self-hosted</span>
          <h3>Free, forever, with everything.</h3>
          <p>
            Every feature, no limits and no license key. Your data never leaves your servers. Apache-2.0.
          </p>
          <a class="btn" href="/docs/self-hosting/">Read the self-hosting guide</a>
        </div>
        <div class="option highlight">
          <span class="tag soon">Cloud · coming soon</span>
          <h3>Or let us run it for you.</h3>
          <p>
            Trailscope Cloud: the same software, hosted in the EU, with a free plan and simple monthly
            pricing.
          </p>
          <a class="btn primary" href="/pricing/">See planned pricing</a>
        </div>
      </div>
      <div style="margin-top: 16px">
        <Waitlist />
      </div>
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.dataset.copied = '';
        setTimeout(() => delete button.dataset.copied, 1500);
      } catch {
        // Clipboard unavailable (insecure context): the commands stay selectable.
      }
    });
  }
</script>
