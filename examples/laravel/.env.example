APP_NAME=tasks-api
APP_ENV=local
APP_DEBUG=false

# Log lines go to stderr and, through the "trailscope" channel the SDK registers, to Trailscope.
LOG_CHANNEL=stack
LOG_STACK=stderr,trailscope
LOG_LEVEL=info

DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=array

TRAILSCOPE_ENDPOINT=http://localhost:8080
TRAILSCOPE_INGEST_KEY=
TRAILSCOPE_SERVICE=tasks-api-laravel
