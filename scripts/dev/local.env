# Environment for running Logbox from source against deploy/docker-compose.dev.yml:
#   source scripts/dev/local.env && cargo run -- all     (UI on http://localhost:8090)
export LOGBOX_CLICKHOUSE_URL=http://127.0.0.1:18123
export LOGBOX_CLICKHOUSE_USER=logbox
export LOGBOX_CLICKHOUSE_PASSWORD=logbox
export LOGBOX_POSTGRES_URL=postgres://logbox:logbox@127.0.0.1:25432/logbox
export LOGBOX_SERVER_LISTEN=127.0.0.1:8090
export LOGBOX_SERVER_PUBLIC_URL=http://localhost:8090
export LOGBOX_SECRET_KEY=dev-secret-key-for-local-testing-only

# Integration tests (cargo test) use their own databases on the same servers.
export LOGBOX_TEST_CLICKHOUSE_URL=http://127.0.0.1:18123
export LOGBOX_TEST_CLICKHOUSE_USER=logbox
export LOGBOX_TEST_CLICKHOUSE_PASSWORD=logbox
export LOGBOX_TEST_POSTGRES_URL=postgres://logbox:logbox@127.0.0.1:25432/logbox
