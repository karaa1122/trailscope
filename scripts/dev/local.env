# Environment for running Trailscope from source against deploy/docker-compose.dev.yml:
#   source scripts/dev/local.env && cargo run -- all     (UI on http://localhost:8090)
export TRAILSCOPE_CLICKHOUSE_URL=http://127.0.0.1:18123
export TRAILSCOPE_CLICKHOUSE_USER=trailscope
export TRAILSCOPE_CLICKHOUSE_PASSWORD=trailscope
export TRAILSCOPE_POSTGRES_URL=postgres://trailscope:trailscope@127.0.0.1:25432/trailscope
export TRAILSCOPE_SERVER_LISTEN=127.0.0.1:8090
export TRAILSCOPE_SERVER_PUBLIC_URL=http://localhost:8090
export TRAILSCOPE_SECRET_KEY=dev-secret-key-for-local-testing-only

# Integration tests (cargo test) use their own databases on the same servers.
export TRAILSCOPE_TEST_CLICKHOUSE_URL=http://127.0.0.1:18123
export TRAILSCOPE_TEST_CLICKHOUSE_USER=trailscope
export TRAILSCOPE_TEST_CLICKHOUSE_PASSWORD=trailscope
export TRAILSCOPE_TEST_POSTGRES_URL=postgres://trailscope:trailscope@127.0.0.1:25432/trailscope
