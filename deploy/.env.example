# Copy to deploy/.env and adjust; docker compose reads it automatically.

# The URL people and email links use. Use https behind a reverse proxy.
LOGBOX_PUBLIC_URL=http://localhost:8080
LOGBOX_PORT=8080

# Encrypts stored secrets and signs mute links: openssl rand -base64 48
LOGBOX_SECRET_KEY=

# Database passwords (change all three before the first start).
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_READER_PASSWORD=change-me-too
POSTGRES_PASSWORD=change-me-as-well

# Retention in days: everything, and bodies/headers (must be <= the first).
LOGBOX_RETENTION_DAYS=30
LOGBOX_RETENTION_BODY_DAYS=7

# Optional: email for alerts. Leave a line empty (or out) to set that field in
# Settings → Notifications instead; a value here locks the field in the UI.
# LOGBOX_SMTP_HOST=smtp.example.com
# LOGBOX_SMTP_PORT=587
# LOGBOX_SMTP_SECURITY=starttls
# LOGBOX_SMTP_USERNAME=
# LOGBOX_SMTP_PASSWORD=
# LOGBOX_SMTP_FROM=logbox@example.com
# LOGBOX_SMTP_FROM_NAME=Logbox

# Optional: single sign-on with an OpenID Connect provider (see docs/configuration.md).
# LOGBOX_OIDC_ISSUER=https://accounts.google.com
# LOGBOX_OIDC_CLIENT_ID=
# LOGBOX_OIDC_CLIENT_SECRET=
# LOGBOX_OIDC_DISPLAY_NAME=Google
# LOGBOX_OIDC_AUTO_CREATE_DOMAINS='["example.com"]'

# Use a published image instead of building from source, e.g.
# LOGBOX_IMAGE=ghcr.io/karaa1122/logbox:latest
